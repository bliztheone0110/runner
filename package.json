{
  "name": "threejs-movement-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/src/index.ts",
    "build:api": "tsc -p server/tsconfig.json",
    "start:api": "node server/dist/server/src/index.js",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "lint:ts": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint": "npm run lint:ts && npm run lint:css && npm run format:check",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"server/**/*.ts\" \"tests/**/*.{ts,html}\" \"*.{ts,js,mjs,cjs,json,html,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"server/**/*.ts\" \"tests/**/*.{ts,html}\" \"*.{ts,js,mjs,cjs,json,html,yml,yaml}\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.180.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.0"
  }
}
