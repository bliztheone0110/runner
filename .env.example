# API settings; Docker Compose supplies these locally.
DATABASE_URL=postgres://momentum:local-development-only@127.0.0.1:5432/momentum
DATABASE_SSL=false
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
PORT=3001

# Leave blank for local Vite proxy; set the public API origin for a separate frontend host.
VITE_API_BASE_URL=
